{
  "name": "server",
  "version": "1.0.50",
  "scripts": {
    "build": "bun build --target=bun ./src/index.ts --outdir ./build",
    "start": "NODE_ENV=production bun ./build/index.js",
    "dev": "bun run sync && bun run --watch src/index.ts",
    "sync": "bun src/crud/sync.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@prisma/client": "5.19.1",
    "elysia": "latest",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "^5.19.1"
  },
  "module": "src/index.js"
}
